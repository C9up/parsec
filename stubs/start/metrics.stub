---
to: start/metrics.ts
---
import router from '@c9up/ream/services/router'
import metrics from '@c9up/parsec/services/main'
import { metricsHandler } from '@c9up/parsec/endpoint'
import env from '#start/env'

/**
 * The scrape endpoint, behind a bearer token. The handler refuses to build
 * with an empty or missing METRICS_TOKEN rather than serve your route table
 * to anyone who asks; for a route only your own network can reach, replace
 * the token with `public: true`.
 */
router.get(
  '/__metrics',
  metricsHandler(metrics, { token: env.get('METRICS_TOKEN') }),
)